+    assert engine.outcome=='returned' and certificates(engine)
+    for method in ('Plan.stops','Item.from','Item.to'):
+        assert ('','executes',ids[method]) in engine.edges
+        assert (ids['Api.entry'],'calls',ids[method]) in engine.edges
