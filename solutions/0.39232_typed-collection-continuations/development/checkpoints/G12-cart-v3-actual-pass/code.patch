+      class Api{Store store;Object entry(Long id){Parent p=new Parent();p.id=id;p.name="new";
+        store.save(p);return p.children;}}'''},
+      rows={'parents':[{'id':1,'name':'existing'}],'children':[{'id':9,'parent_id':1}]})
