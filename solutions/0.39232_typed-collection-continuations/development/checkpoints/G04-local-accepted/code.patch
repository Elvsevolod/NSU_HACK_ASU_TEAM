+      catch(UnsupportedOperationException failure){return "fixed";}return "after";}}'''})
+    assert Engine(p, ScenarioState(db)).run(ids['Api.entry'], {}) == 'fixed'
+
+
+def test_custom_namesake_uses_source_parameter_and_body(tmp_path):
