+    assert not proposals and detail['unresolved']
+
+
+def test_a_literal_id_does_not_create_a_direct_route_around_a_source_ui_guard(tmp_path,monkeypatch):
+    p,ids,g,state=fixture(tmp_path);original=g.index.rank
