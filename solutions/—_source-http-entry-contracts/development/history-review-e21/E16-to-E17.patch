+                previous=item.get('entry')
+                if previous not in self.project.methods:continue
+                shape=result_shape(self.project,previous)
+                if shape!=(types,False) or not any(m==previous and verb=='POST' for m,verb,_ in self.project.ix.handlers):continue
+                meta=self.project.methods[previous]
+                bodies=[self.project.resolve_type(p['type'],meta['module'],meta['file'])
+                    for p in self.project.http_parameters(previous) if p['kind']=='RequestBody']
