+            pars=self.project.http_parameters(mid)
+            if (contract['site'] or contract['verb']!='GET' or collection or len(types)!=1 or len(pars)!=1 or
+                pars[0]['kind']!='PathVariable' or not pars[0]['required']):continue
+            producers=[]
