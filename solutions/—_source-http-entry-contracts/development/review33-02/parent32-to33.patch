+                    '@SpringBootApplication class App {@Bean Plain bean(){return new Plain();}}',
+        'Plain.java': 'import org.springframework.web.bind.annotation.GetMapping; class Plain {@GetMapping("/records") String read(){return "plain";}}',
+    })
