+
+
+@pytest.mark.parametrize('body,suffix', [
+    ('rest.postForObject("http://warehouse/reserve/"+item,null,String.class);', ''),
+    ('RestTemplate alias=rest;alias.postForObject("http://warehouse/reserve/"+item,null,String.class);', ''),
