+"""Bounded Java time bridge over CPython datetime and pinned IANA tzdata.
+
+No host clock or system timezone files are read. Regional rules require an
+explicit target tzdb version. Nanoseconds and years outside CPython's range
+remain unsupported rather than rounded into different Java values.
+"""
+from datetime import date,datetime,time,timedelta,timezone
+from functools import lru_cache
+from importlib.resources import files
+import re
+from zoneinfo import ZoneInfo
+
+import tzdata
+
+from .values import Object,TypeRef,Unknown,Raised,unknown
+from .models import NOT_HANDLED
+
+EPOCH=datetime(1970,1,1,tzinfo=timezone.utc)
+TYPES={'java.time.LocalDate','java.time.LocalDateTime','java.time.ZonedDateTime','java.time.Instant','java.util.Date'}
+
+
+@lru_cache(maxsize=128)
+def zone(name):
+    # Validate resource components before opening package data, never TZPATH.
+    if not re.fullmatch(r'[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)*',name):raise ValueError('Unsupported zone ID')
+    with files('tzdata.zoneinfo').joinpath(*name.split('/')).open('rb') as stream:
+        return ZoneInfo.from_file(stream,key=name)
+
+
+def timezone_value(engine,value,span):
+    if not isinstance(value,Object) or value.typ!='java.time.ZoneId':engine.unsupported('Unresolved Java timezone',span)
+    name=value.fields.get('name')
+    if not isinstance(name,str):engine.unsupported('Unknown Java timezone identifier',span)
+    if name not in {'UTC','GMT','UT','Etc/UTC','Etc/GMT'} and engine.context.get('timezone_database')!=tzdata.IANA_VERSION:
+        engine.unsupported('Regional Java time requires an explicit matching timezone_database ('+tzdata.IANA_VERSION+')',span)
+    try:return zone('UTC' if name=='UT' else name)
+    except (ValueError,OSError):engine.unsupported('Java ZoneId needs a fixed-offset, alias or unavailable IANA contract',span)
+
+
+def now(engine,span):
+    from .security_models import clock
+    raw=engine.context.get('clock')
+    if isinstance(raw,str) and re.search(r'\.\d{7,}',raw):engine.unsupported('Java nanosecond clock precision exceeds the datetime bridge',span)
+    result=clock(engine)
+    if unknown(result):engine.unsupported('Java current time requires an explicit analysis clock',span)
+    try:return result.astimezone(timezone.utc)
+    except OverflowError:engine.unsupported('Java clock exceeds the datetime bridge range',span)
+
+
+def wrapped(engine,typ,value):return engine.state.new(typ,{'value':value})
+
+
+def value(engine,obj,typ,span):
+    if obj is None:raise Raised('NullPointerException')
+    if not isinstance(obj,Object) or obj.typ!=typ or unknown(obj.fields.get('value')):
+        engine.unsupported('Unresolved '+typ+' value',span)
+    result=obj.fields.get('value')
+    if typ=='java.time.LocalDate' and type(result) is date:return result
+    if type(result) is datetime and ((result.tzinfo is None)==(typ=='java.time.LocalDateTime')):return result
+    engine.unsupported('Invalid native value for '+typ,span)
+
+
+def millis(instant):
+    delta=instant-EPOCH
+    return (delta.days*86400+delta.seconds)*1000+delta.microseconds//1000
+
+
+def date_construct(engine,typ,args,kwargs,span):
+    qualified=engine.p.resolve_import(typ,span.file) or typ
+    if qualified!='java.util.Date':return NOT_HANDLED
+    if kwargs:return NOT_HANDLED
+    if not args:instant=now(engine,span)
+    elif len(args)==1 and type(args[0]) is int:
+        try:instant=EPOCH+timedelta(milliseconds=args[0])
+        except OverflowError:engine.unsupported('Java Date exceeds the datetime bridge year range',span)
+    else:engine.unsupported('Unmodeled Java Date constructor overload',span)
+    return wrapped(engine,'java.util.Date',EPOCH+timedelta(milliseconds=millis(instant)))
+
+
+def call(engine,receiver,name,args,kwargs,span):
+    typ=receiver.name if isinstance(receiver,TypeRef) else receiver.typ if isinstance(receiver,Object) else ''
+    if typ not in TYPES|{'java.time.ZoneId'}:return NOT_HANDLED
+    if kwargs:return NOT_HANDLED
+    static=isinstance(receiver,TypeRef)
+    if static and typ=='java.time.ZoneId' and name in {'of','systemDefault'}:
+        if name=='systemDefault' and not args:identifier=engine.context.get('timezone')
+        elif name=='of' and len(args)==1:identifier=args[0]
+        else:return NOT_HANDLED
+        if identifier is None:engine.unsupported('Java system timezone is not supplied',span)
+        result=engine.state.new(typ,{'name':identifier});timezone_value(engine,result,span)
+        return result
+    if static and name=='now' and typ in {'java.time.LocalDate','java.time.Instant'}:
+        instant=now(engine,span)
+        if typ=='java.time.Instant' and not args:return wrapped(engine,typ,instant)
+        if typ=='java.time.LocalDate' and len(args)<=1:
+            selected=args[0] if args else engine.state.new('java.time.ZoneId',{'name':engine.context.get('timezone')})
+            return wrapped(engine,typ,instant.astimezone(timezone_value(engine,selected,span)).date())
+        return NOT_HANDLED
+    if static and name=='of' and typ in {'java.time.LocalDate','java.time.LocalDateTime'}:
+        counts={3} if typ.endswith('.LocalDate') else {5,6}
+        if len(args) not in counts or any(type(arg) is not int for arg in args):return NOT_HANDLED
+        if not 1<=args[0]<=9999:engine.unsupported('Java time year exceeds the datetime bridge range',span)
+        try:result=date(*args) if typ.endswith('.LocalDate') else datetime(*args)
+        except ValueError:raise Raised('DateTimeException') from None
+        return wrapped(engine,typ,result)
+    if static and typ=='java.time.Instant' and name=='ofEpochMilli' and len(args)==1 and type(args[0]) is int:
+        try:return wrapped(engine,typ,EPOCH+timedelta(milliseconds=args[0]))
+        except OverflowError:engine.unsupported('Java Instant exceeds the datetime bridge range',span)
+    if static and typ=='java.util.Date' and name=='from' and len(args)==1:
+        instant=value(engine,args[0],'java.time.Instant',span)
+        return wrapped(engine,typ,EPOCH+timedelta(milliseconds=millis(instant)))
+    if static:engine.unsupported('Java temporal static method '+typ+'.'+name,span)
+    if typ=='java.time.ZoneId':
+        if name in {'getId','toString'} and not args:return receiver.fields.get('name',Unknown('Unknown Java timezone ID'))
+        engine.unsupported('Java ZoneId method '+name,span)
+    current=value(engine,receiver,typ,span)
+    if typ=='java.time.LocalDate' and name=='atStartOfDay' and not args:
+        return wrapped(engine,'java.time.LocalDateTime',datetime.combine(current,time()))
+    if typ=='java.time.LocalDateTime' and name=='atZone' and len(args)==1:
+        selected=timezone_value(engine,args[0],span)
+        # fold=0 selects the earlier offset in overlaps; round-trip through UTC
+        # shifts nonexistent local times by the gap, as LocalDateTime.atZone.
+        try:result=current.replace(tzinfo=selected,fold=0).astimezone(timezone.utc).astimezone(selected)
+        except OverflowError:engine.unsupported('Zoned Java time exceeds the datetime bridge range',span)
+        return wrapped(engine,'java.time.ZonedDateTime',result)
+    if typ in {'java.time.ZonedDateTime','java.util.Date'} and name=='toInstant' and not args:
+        return wrapped(engine,'java.time.Instant',current.astimezone(timezone.utc))
+    if typ in {'java.time.Instant','java.util.Date'} and name==('getTime' if typ=='java.util.Date' else 'toEpochMilli') and not args:return millis(current)
+    if name in {'equals','isBefore','isAfter','before','after'} and len(args)==1 and typ!='java.time.ZonedDateTime':
+        if name=='equals' and (not isinstance(args[0],Object) or args[0].typ!=typ):return False
+        other=value(engine,args[0],typ,span)
+        return current==other if name=='equals' else current<other if name in {'isBefore','before'} else current>other
+    if name=='toEpochDay' and typ=='java.time.LocalDate' and not args:return (current-date(1970,1,1)).days
+    if name=='toString' and typ=='java.time.LocalDate' and not args:return current.isoformat()
+    engine.unsupported('Java temporal instance method '+typ+'.'+name,span)
--- phase4/code/polygraph/java_validation.py
+++ phase5/code/polygraph/java_validation.py
@@ -0,0 +1,136 @@
+"""Field Bean Validation subset over IR values, with native Pydantic bounds.
+
+Source getter/custom validators and custom groups remain explicit cutoffs.
+Length measures Java UTF-16 code units, not Python Unicode code points.
+"""
+from functools import lru_cache
+import re
+from typing import Annotated
+
+from pydantic import Field,TypeAdapter,ValidationError
+
+from .values import Object,Raised,Symbol,unknown
+
+PACKAGES={'javax.validation.constraints','jakarta.validation.constraints','org.hibernate.validator.constraints'}
+SUPPORTED={'NotNull','Null','Length','Size','Min','Max','AssertTrue','AssertFalse','NotEmpty'}
+
+
+def qualified(project,name,file):
+    explicit=project.resolve_import(name,file)
+    if explicit:return explicit
+    if '.' in name:return name
+    custom=project.adapters['java'].custom_constraints
+    local=project.adapters['java'].package_names.get(file,'')
+    local=(local+'.' if local else '')+name
+    if local in custom:return local
+    if name in {'Valid','Validated'}:
+        candidates={package+'.'+name for package in project.import_wildcards[file] if package in {'javax.validation','jakarta.validation','org.springframework.validation.annotation'}}
+        return candidates.pop() if len(candidates)==1 else ''
+    candidates={package+'.'+name for package in project.import_wildcards[file] if package in PACKAGES}
+    candidates|={package+'.'+name for package in project.import_wildcards[file] if package+'.'+name in custom}
+    return candidates.pop() if len(candidates)==1 else ''
+
+
+@lru_cache(maxsize=256)
+def bounds(minimum,maximum):return TypeAdapter(Annotated[int,Field(ge=minimum,le=maximum)])
+
+
+def literal(engine,raw,name,default,span):
+    if name!='value' and not re.search(r'\b'+name+r'\s*=',raw):return default
+    pattern=r'\b'+name+r'\s*=\s*([+-]?\d[\d_]*)[lL]?(?=\s*[,\)])' if name!='value' or 'value' in raw else r'^\(\s*([+-]?\d[\d_]*)[lL]?\s*\)$'
+    found=re.search(pattern,raw)
+    if not found:engine.unsupported('Nonliteral Bean Validation bound',span)
+    return int(found[1].replace('_',''))
+
+
+def reject(engine,field,constraint,span):
+    engine.note('bean-validation','Source field fails a checked constraint',span,field=field,constraint=constraint)
+    raise Raised('MethodArgumentNotValidException')
+
+
+def constraint(engine,name,raw,value,typ,field,span):
+    if 'groups' in raw:engine.unsupported('Custom Bean Validation groups',span)
+    if name not in SUPPORTED:engine.unsupported('Bean Validation constraint '+name+' needs an additional contract',span)
+    if name=='NotNull':
+        if value is None:reject(engine,field,name,span)
+        if unknown(value) and not isinstance(value,Symbol):engine.unsupported('Unknown nullability during Bean Validation',span)
+        if isinstance(value,Symbol) and not value.nonnull:engine.unsupported('Unknown symbol nullability during Bean Validation',span)
+        return
+    if name=='Null':
+        if unknown(value):engine.unsupported('Unknown value for a Null constraint',span)
+        if value is not None:reject(engine,field,name,span)
+        return
+    if value is None:
+        if name=='NotEmpty':reject(engine,field,name,span)
+        return
+    if unknown(value):engine.unsupported('Unknown value during Bean Validation',span)
+    if name in {'AssertTrue','AssertFalse'}:
+        if type(value) is not bool:engine.unsupported('Non-boolean assertion constraint',span)
+        if value!=(name=='AssertTrue'):reject(engine,field,name,span)
+        return
+    if name in {'Length','Size','NotEmpty'}:
+        raw_type=typ.split('<')[0].split('.')[-1]
+        if raw_type not in {'String','CharSequence','List','Set','Collection','Map','Iterable'} and not typ.endswith('[]'):engine.unsupported('Constraint on an unmodeled sized Java type',span)
+        if name=='Length' and not isinstance(value,str):engine.unsupported('Length constraint requires a CharSequence',span)
+        if not isinstance(value,(str,list,tuple,dict)):engine.unsupported('Unmodeled sized Java value',span)
+        measure=len(value.encode('utf-16-le',errors='surrogatepass'))//2 if isinstance(value,str) else len(value)
+        minimum=1 if name=='NotEmpty' else literal(engine,raw,'min',0,span)
+        maximum=2147483647 if name=='NotEmpty' else literal(engine,raw,'max',2147483647,span)
+    else:
+        if type(value) is not int:engine.unsupported('Non-integral Min/Max value',span)
+        measure=value;limit=literal(engine,raw,'value',None,span)
+        minimum,maximum=(limit,None) if name=='Min' else (None,limit)
+    if minimum is not None and maximum is not None and (minimum<0 and name in {'Length','Size'} or maximum<minimum):engine.unsupported('Invalid Bean Validation bounds',span)
+    try:bounds(minimum,maximum).validate_python(measure,strict=True)
+    except ValidationError:reject(engine,field,name,span)
+
+
+def validate(engine,key,value,span,active=frozenset()):
+    if value is None:return
+    if unknown(value):engine.unsupported('Unknown cascaded Bean Validation value',span)
+    if (key,id(value)) in active:return
+    active=active|{(key,id(value))}
+    info=engine.p.types[key]
+    if set(info.annotations)&{'GroupSequence','GroupSequenceProvider'}:engine.unsupported('Custom Bean Validation default sequence',info.span)
+    if any(qualified(engine.p,name,info.span.file).rpartition('.')[0] in PACKAGES or qualified(engine.p,name,info.span.file) in engine.p.adapters['java'].custom_constraints for name in info.annotations.get('validation_annotations',{})):engine.unsupported('Class-level Bean Validation callback',info.span)
+    for method_key in info.methods:
+        method=engine.p.methods[method_key]
+        if any(qualified(engine.p,name,info.span.file).rpartition('.')[0] in PACKAGES or qualified(engine.p,name,info.span.file) in engine.p.adapters['java'].custom_constraints or qualified(engine.p,name,info.span.file) in {'javax.validation.Valid','jakarta.validation.Valid'} for name in method.annotations.get('validation_annotations',{})):engine.unsupported('Getter-based Bean Validation requires a source callback contract',method.span)
+    fields=value.fields if isinstance(value,Object) else value
+    if not isinstance(fields,dict):engine.unsupported('Unmodeled bean value',span)
+    if any('@' in typ for typ,_ in info.fields.values()):engine.unsupported('Type-use Bean Validation requires a container-element contract',info.span)
+    for parent in info.parents:
+        resolved=engine.p.resolve_type(parent,info.module,info.span.file)
+        if resolved:
+            if set(engine.p.types[resolved].fields)&set(info.fields):engine.unsupported('Shadowed Java validation fields',span)
+            validate(engine,resolved,value,span,active)
+    for field,annotations in info.annotations.get('field_annotations',{}).items():
+        current=fields.get(field)
+        typ=info.fields[field][0]
+        for name,raw in annotations.items():
+            full=qualified(engine.p,name,info.span.file)
+            if full in engine.p.adapters['java'].custom_constraints:engine.unsupported('Custom field Bean Validation callback',info.span)
+            if full.rpartition('.')[0] in PACKAGES:constraint(engine,name.split('.')[-1],raw,current,typ,field,info.span)
+        if any(name.split('.')[-1]=='ConvertGroup' for name in annotations):engine.unsupported('Cascaded validation group conversion',span)
+        if not any(qualified(engine.p,name,info.span.file) in {'javax.validation.Valid','jakarta.validation.Valid'} for name in annotations) or current is None:continue
+        if unknown(current):engine.unsupported('Unknown cascaded field',span)
+        inner=re.fullmatch(r'(?:[\w.]+)(?:<(.+)>)?',typ)
+        if isinstance(current,(list,tuple)):
+            child_type=inner[1] if inner and inner[1] else typ.removesuffix('[]')
+            children=current
+        elif isinstance(current,dict) and typ.split('<')[0].split('.')[-1]=='Map':
+            child_type=inner[1].split(',')[-1].strip() if inner and inner[1] else '';children=current.values()
+        else:child_type=typ;children=[current]
+        resolved=engine.p.resolve_type(child_type,info.module,info.span.file)
+        if resolved:
+            for child in children:validate(engine,resolved,child,span,active)
+
