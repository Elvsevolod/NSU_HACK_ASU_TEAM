+            if not relative:return ''
+            parts=[]
+            for part in (PurePosixPath(file).parent/PurePosixPath(relative)).parts:
+                if part=='..':
+                    if not parts:return ''
+                    parts.pop()
+                elif part!='.':parts.append(part)
+            file='/'.join(parts)
+        return ''
