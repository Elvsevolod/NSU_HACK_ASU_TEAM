{
  "scenario": {
    "project": "public-java",
    "id": "invalid-body-before-handler",
    "steps": [
      {
        "action": "Explicit conditional public-source HTTP request",
        "request": {
          "module": "account-service",
          "path": "/accounts/current",
          "method": "PUT",
          "body": {
            "incomes": [
              {
                "title": "Salary",
                "amount": "20",
                "currency": "USD",
                "period": "DAY"
              }
            ],
            "expenses": [
              {
                "title": "Rent",
                "amount": "8",
                "currency": "EUR",
                "period": "DAY"
              }
            ],
            "saving": null,
            "note": "Changed"
          }
        }
      }
    ]
  },
  "context": {
    "clock": "2026-01-02T10:00:00Z",
    "timezone": "UTC",
    "principal": {
      "name": "reader"
    },
    "configuration": {
      "account-service": {
        "name": "account-service",
        "profiles": [
          "default"
        ],
        "propertySources": [
          {
            "name": "config/src/main/resources/shared/account-service.yml",
            "source": {
              "security.oauth2.client.clientId": "account-service",
              "security.oauth2.client.clientSecret": "${ACCOUNT_SERVICE_PASSWORD}",
              "security.oauth2.client.accessTokenUri": "http://auth-service:5000/uaa/oauth/token",
              "security.oauth2.client.grant-type": "client_credentials",
              "security.oauth2.client.scope": "server",
              "spring.data.mongodb.host": "account-mongodb",
              "spring.data.mongodb.username": "user",
              "spring.data.mongodb.password": "${MONGODB_PASSWORD}",
              "spring.data.mongodb.database": "piggymetrics",
              "spring.data.mongodb.port": 27017,
              "server.servlet.context-path": "/accounts",
              "server.port": 6000,
              "feign.hystrix.enabled": true
            }
          },
          {
            "name": "config/src/main/resources/shared/application.yml",
            "source": {
              "logging.level.org.springframework.security": "INFO",
              "hystrix.command.default.execution.isolation.thread.timeoutInMilliseconds": 10000,
              "eureka.instance.prefer-ip-address": true,
              "eureka.client.serviceUrl.defaultZone": "http://registry:8761/eureka/",
              "security.oauth2.resource.user-info-uri": "http://auth-service:5000/uaa/users/current",
