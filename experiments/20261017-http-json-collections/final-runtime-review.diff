+            variables=project.type_variables.get(owner,{})
+            if arguments is None or arguments and len(arguments)!=len(variables):return fail('HTTP DTO generic argument count is not modeled')
+            local={name:(arg,context,bindings) for name,arg in zip(variables,arguments)} if arguments else {
+                name:(bound,project.nodes[owner],{}) for name,bound in variables.items() if bound is not None}
+            annotations=project.nodes[owner].get('annotations',[])
+            if any(a['name'].split('.')[-1] in ('JsonDeserialize','JsonSerialize','JsonTypeInfo') for a in annotations):
