+        if isinstance(value,(dict,list)):
+            return fail('HTTP structured value has an unsupported declared type: '+written)
+        simple=base.rsplit('.',1)[-1]
+        scalars={'String':str,'Boolean':bool,'boolean':bool,'Integer':int,'int':int,
